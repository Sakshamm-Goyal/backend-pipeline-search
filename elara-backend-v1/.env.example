# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
# CORS_ORIGINS=http://localhost:3001,https://yourdomain.com

# Database
MONGODB_URI=mongodb://localhost:27017/elara

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-token-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Apple OAuth (Optional - leave commented out if not using Apple Sign In)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8
# APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@elara.com

# Google Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=elara-storage
GCP_KEY_FILE=./gcp-service-account-key.json
GCS_SIGNED_URL_EXPIRATION=3600
