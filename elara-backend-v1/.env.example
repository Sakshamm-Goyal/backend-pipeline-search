# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
# CORS_ORIGINS=http://localhost:3001,https://yourdomain.com

# Database
MONGODB_URI=mongodb://localhost:27017/elara

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-token-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Apple OAuth (Optional - leave commented out if not using Apple Sign In)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8
# APPLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/apple/callback

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM=noreply@elara.com

# Google Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=elara-storage
GCP_KEY_FILE=./gcp-service-account-key.json
GCS_SIGNED_URL_EXPIRATION=3600
# ============================================
# AI PIPELINE CONFIGURATION
# ============================================

# LLM Configuration
ANTHROPIC_API_KEY=your-claude-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4.5
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4000

GOOGLE_AI_API_KEY=your-gemini-api-key-here
GEMINI_REASONING_MODEL=gemini-3-pro-preview
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4000

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379

# Search APIs
OXYLABS_USERNAME=your-oxylabs-username
OXYLABS_PASSWORD=your-oxylabs-password
SHOPSTYLE_API_KEY=your-shopstyle-api-key
RAPIDAPI_KEY=your-rapidapi-key
BRAVE_API_KEY=your-brave-api-key
WALMART_API_KEY=your-walmart-api-key
TARGET_API_KEY=your-target-api-key

# Feature Flags
ENABLE_OXYLABS=true
ENABLE_ASOS=true
ENABLE_BRAVE_SEARCH=true
ENABLE_WALMART=true
ENABLE_TARGET=true
ENABLE_CLAUDE_WEB_SEARCH=false   # Expensive - uses Claude API, enable only if needed
ENABLE_SHOPSTYLE=false           # Deprecated - returns 401 errors
ENABLE_PLAYWRIGHT_SCRAPERS=true
ENABLE_LLM_RERANK=true
ENABLE_VECTOR_SEARCH=true

# Timeout Configuration (milliseconds)
SEARCH_TIMEOUT_MS=8000
LLM_TIMEOUT_MS=30000

# Rate Limits (requests per second)
OXYLABS_RATE_LIMIT=10
SHOPSTYLE_RATE_LIMIT=5
BRAVE_RATE_LIMIT=1               # Brave free tier is 1 req/s, paid is 20 req/s
WALMART_RATE_LIMIT=5
TARGET_RATE_LIMIT=5

# Cache TTL (seconds)
CACHE_SEARCH_TTL=3600
CACHE_USER_CONTEXT_TTL=300
CACHE_WEATHER_TTL=21600
CACHE_PRODUCTS_TTL=86400
CACHE_OUTFIT_TTL=3600
CACHE_USER_PROFILE_TTL=1800
CACHE_LLM_RESPONSE_TTL=172800
CACHE_LLM_RERANK_TTL=172800
CACHE_VERIFICATION_TTL=21600

# ============================================
# EMBEDDINGS & VECTOR SEARCH
# ============================================

# OpenAI (for embeddings)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ============================================
# IMAGE PROCESSING
# ============================================

# Background Removal (choose one or more providers)
# Remove.bg
REMOVEBG_API_KEY=your-removebg-api-key

# Replicate (for AI models)
REPLICATE_API_TOKEN=your-replicate-api-token

# Background removal provider priority (comma-separated: removebg,replicate,local)
BG_REMOVAL_PROVIDERS=removebg,replicate

# ============================================
# ANALYTICS & TRACKING
# ============================================

# Analytics batch size
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL_MS=60000

# ============================================
# PERSONALIZATION
# ============================================

# Personalization enabled
ENABLE_PERSONALIZATION=true

# Personalization weight in ranking (0.0 - 1.0)
PERSONALIZATION_WEIGHT=0.3

# ============================================
# OUTFIT SCORING
# ============================================

# Enable AI-based outfit scoring
ENABLE_OUTFIT_SCORING=true

# Semantic similarity threshold for outfit compatibility
OUTFIT_SIMILARITY_THRESHOLD=0.5

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================

# WebSocket CORS origin
WS_CORS_ORIGIN=http://localhost:3001

# ============================================
# WEATHER API
# ============================================

# OpenWeather API
OPENWEATHER_API_KEY=your-openweather-api-key

# ============================================
# SCRAPER CONFIGURATION
# ============================================

# Max concurrent searches
MAX_CONCURRENT_SEARCHES=10
SEARCH_BATCH_SIZE=10
SEARCH_BATCH_DELAY_MS=100
